ANTHROPIC_API_KEY=
# anthropic | bedrock | foundry
LLM_PROVIDER=anthropic
# live (calls API + records) | replay (recorded responses, $0) | off (no agents)
LLM_MODE=replay
MAX_USD_PER_RUN=0.50
ORCHESTRATOR_MODEL=claude-sonnet-5-5
AUDITOR_MODEL=claude-sonnet-5-5
REVIEWER_MODEL=claude-sonnet-5-5
NOTICE_MODEL=claude-haiku-5-5
BROWSER_ALLOWLIST=localhost:8100
# Bedrock (LLM_PROVIDER=bedrock): uses your AWS credentials
AWS_REGION=
# Foundry (LLM_PROVIDER=foundry)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
JEV_API_KEY=
JEV_BASE_URL=
